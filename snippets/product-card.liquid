{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign handle = product.handle
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign secondary_image = product.images[1] | default: product.featured_image
  assign title = product.title
  assign vendor = product.vendor
  assign url = product.url
  assign sale = false

  if product.compare_at_price > product.price
    assign sale = true
  endif
%}

<article
  class="p-4 product-card__container"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-handle="{{ handle }}"
  role="region"
  aria-labelledby="product-title-{{ product.id }}">
  <div class="product-card__inner">
    <a href="{{ url }}" aria-label="View details for {{ title }}">
      <figure class="product-card-image__container relative w-full h-full aspect-square max-w-[315px] max-h-[340px] p-4 mb-4 border border-gray-200
rounded-lg group">
        <img src="{{ featured_image | image_url }}" alt="{{ current_variant.title }}" class="object-contain object-center w-full h-full product-card-image group-hover:hidden" width="275" height="300" />
        <img src="{{ secondary_image | image_url }}" alt="{{ current_variant.title }} Alternative" class="object-contain object-center w-full h-full product-card-image--secondary group-hover:!opacity-100 opacity-0" width="275" height="300" />
        {% if sale %}
          <figcaption class="absolute px-2 border text-error border-error sale-badge top-3 left-3 rounded-2xl">On Sale!</figcaption>
        {% endif %}
      </figure>
    </a>
    <div class="product-card-content__container">
      <div class="z-50 mb-4 variants__container">
        {% render 'variant-swatches', product: product %}
      </div>
      <div class="flex flex-col gap-2 product-card-content--info">
        <p class="text-sm">{{ vendor }}</p>
        <a href="{{ url }}" id="product-title-{{ product.id }}">
          <h5 class="text-base font-medium duration-75 text-teal hover:opacity-70">{{ title }}</h5>
        </a>
        {% if sale %}
          <div class="flex flex-row gap-1 product-price__container">
            <p class="text-sm text-black line-through">{{ product.compare_at_price | money }}</p>
            <p class="text-sm text-error">{{ product.price | money }}</p>
          </div>
        {% else %}
          <div class="product-price__container">
            <p class="text-sm">{{ product.price | money }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</article>
